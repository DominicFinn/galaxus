<?xml version="1.0" encoding="utf-8"?>
<!-- Used only during a web export: tools/export-web.sh copies it to game/nuget.config and removes it
     afterwards. It takes the Godot packages from the community web build, in a cache of their own.
     GODOT_WEB_NUGET_PLACEHOLDER is replaced with the package folder. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget-web" />
  </config>
  <packageSources>
    <add key="godot-web" value="GODOT_WEB_NUGET_PLACEHOLDER" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="godot-web">
      <package pattern="Godot*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
