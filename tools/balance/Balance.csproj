<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plays every battle with a bot at each difficulty and reports win rates (Galaxus.Core.Battles.Balance). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/Galaxus.Core/Galaxus.Core.csproj" />
  </ItemGroup>
</Project>
