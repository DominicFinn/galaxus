// Things a scan can turn up. "where" says what can carry it: body (planets and moons), rock
// (asteroids) or ship. A find with "leadsTo" points at a cache of that id somewhere else: scan the
// body it names and the cache is yours. Caches are only found by following a lead.
// Text can use {system}, {body}, {target} and {targetBody}. Keep it short, plain and in canon:
// the strange stuff hints and never explains.
[
  { "id": "dominion-beacon", "where": ["body"], "weight": 3, "title": "A Dominion beacon",
    "text": "A Corvane Gate Office beacon in a decaying orbit round {body}, still repeating a toll notice nobody has paid in centuries. Its log names a paymaster's drop at {targetBody}, {target}.",
    "leadsTo": "dominion-paychest" },
  { "id": "dominion-paychest", "where": ["cache"], "weight": 1, "title": "The paymaster's drop",
    "text": "Under the dust on {body}: a sealed Gate Office strongbox, exactly where the beacon said. The toll money inside is in coin nobody mints any more, which collectors pay very well for.",
    "credits": 9000 },
  { "id": "lost-survey-drone", "where": ["body"], "weight": 4, "title": "A lost survey drone",
    "text": "A survey society drone, battery flat, parked on {body}. Its memory is intact and the society pays a finder's fee.",
    "credits": 1200 },
  { "id": "walkout-wreck", "where": ["body"], "weight": 2, "title": "A wreck from the Walkout",
    "text": "A Dominion hauler on {body}, crew stations empty and the machine berths neatly made up. Whoever left it stopped work on one day and never came back. Its manifest mentions a spare parts store at {targetBody}, {target}.",
    "leadsTo": "walkout-store" },
  { "id": "walkout-store", "where": ["cache"], "weight": 1, "title": "The Hands' store",
    "text": "A cave on {body}, sealed from the inside, stacked with spare parts in perfect order. Someone kept the inventory current long after the Dominion stopped asking for it.",
    "goods": { "machine-parts": 8 }, "credits": 3000 },
  { "id": "horde-marker", "where": ["body"], "weight": 2, "regions": ["outer", "rim"], "title": "A Horde marker",
    "text": "A stone on {body} cut with the sign of the Old Horde, claiming the system for the Goddess. The cutting is recent. Orcs will tell you it is very old.",
    "credits": 400 },
  { "id": "elder-fragment", "where": ["body", "rock"], "weight": 1, "regions": ["outer", "rim"], "title": "An elder machine fragment",
    "text": "A piece of elder machinery bedded in {body}, warm to the sensors with no power source anyone can find. Ruin Courts traders would buy it. So would people who ask fewer questions.",
    "goods": { "elder-relics": 1 } },
  { "id": "odd-signal", "where": ["body"], "weight": 2, "regions": ["outer", "rim"], "title": "A signal that shouldn't be there",
    "text": "A carrier on a dead band near {body}, repeating your own call sign back to you with a delay of a few seconds. It stops when you stop scanning." },
  { "id": "smuggler-stash", "where": ["body", "rock"], "weight": 3, "title": "A smuggler's stash",
    "text": "A shielded canister wedged into {body}, left for a pickup that never came. The tags have been filed off.",
    "goods": { "grav-spirits": 3 } },
  { "id": "rich-seam", "where": ["rock"], "weight": 6, "title": "A rich seam",
    "text": "The scan lights up: a seam of rare metal running right through {body}. Cut carefully and it pays far better than the rest of the belt.",
    "goods": { "rare-earth-ore": 4 } },
  { "id": "claim-stake", "where": ["rock"], "weight": 3, "title": "A claim stake",
    "text": "A rusted claim beacon on {body}, registered to a prospector whose licence lapsed twenty years ago. It names their other claim at {targetBody}, {target}.",
    "leadsTo": "prospector-cache" },
  { "id": "prospector-cache", "where": ["cache"], "weight": 1, "title": "The prospector's cache",
    "text": "The other claim on {body}: a prefab hut, a cot, a stove and a crate of sorted ore samples, labelled in a careful hand. Nobody has been back.",
    "goods": { "tungsten-ore": 6, "rare-earth-ore": 6 } },
  { "id": "ship-hidden-cargo", "where": ["ship"], "weight": 3, "title": "Cargo not on the manifest",
    "text": "{body} is carrying more than it declared: a compartment the size of a coffin behind the reactor shielding. You could report it. You could also remember it." },
  { "id": "ship-old-chart", "where": ["ship"], "weight": 2, "title": "An old chart in a ship's memory",
    "text": "{body}'s nav memory still holds a chart from a previous owner, with one body marked and nothing said: {targetBody}, {target}.",
    "leadsTo": "marked-body" },
  { "id": "marked-body", "where": ["cache"], "weight": 1, "title": "The marked body",
    "text": "On {body}, where the chart was marked: a crashed courier's data core, intact. Its owners are long gone and its contents still sell.",
    "credits": 5000 },
  { "id": "renn-strongbox", "where": ["cache"], "weight": 1, "title": "A strongbox with Renn's seal",
    "text": "On {body}, a strongbox stamped with the Regent's seal, the lock long since cut. Inside: Restoration coin, a few medals, and a letter addressed to nobody. Whether it was ever Renn's is anyone's guess. The coin, at least, is real.",
    "credits": 14000 },
  { "id": "yards-hull", "where": ["cache"], "weight": 1, "title": "A sealed Dominion hull",
    "text": "Near {body}: one of the great hulls from the Silent Yards, sealed since the Walkout. The crew berths are empty and the machine berths are neatly made up. The cargo holds are full.",
    "goods": { "machine-parts": 10, "derelict-hull-plate": 10 }, "credits": 6000 },
  { "id": "horde-hoard", "where": ["cache"], "weight": 1, "title": "The hoard of the Old Horde",
    "text": "On {body}: a buried vault, exactly where the orc said. Inside are cups, plates and enough cutlery for a thousand guests, carefully stacked by seating order. No crowns, no tribute. Orcs will say the tribute was eaten. The silver, at least, sells.",
    "credits": 8000 },
  { "id": "quiet-courier", "where": ["cache"], "weight": 1, "title": "The quiet courier",
    "text": "Near {body}: the courier, drifting, every system powered down by hand. No crew aboard and no sign of a fight. The data core is still in its cradle. The Directorate will pay for it and ask you not to have looked.",
    "credits": 11000 }
]
