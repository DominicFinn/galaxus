<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Galaxus</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/Galaxus.Core/Galaxus.Core.csproj" />
  </ItemGroup>
  <!-- Web build: content loading uses reflection-based JSON, so keep it and keep our code whole. -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <!-- The web runtime needs an entry point; desktop builds are a library and mustn't have one. -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' != 'web' ">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <TrimmerRootAssembly Include="Galaxus.Core" />
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
  </ItemGroup>
  <!--
    Web AOT experiment (docs/web-aot.md): with GalaxusWebAot=true (an environment variable works),
    the web publish also compiles every assembly ahead of time to WebAssembly objects, which
    tools/build-web-aot.sh links into custom web templates. The IL stays in the assemblies, so
    the interpreter can still run anything the AOT compiler skipped.
  -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' and '$(GalaxusWebAot)' == 'true' ">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
  </PropertyGroup>
</Project>
