<?xml version="1.0" encoding="utf-8"?>
<!-- Web export experiment: take the Godot packages from the community web build, in a cache of their own. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget-web" />
  </config>
  <packageSources>
    <add key="godot-web" value="../../godot-dotnet-web/nuget-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="godot-web">
      <package pattern="Godot*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
